load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/container/go:defs.bzl", "go_container_image")

MODULE_VERSION = module_version()

gazelle(
    name = "gazelle",
)

go_library(
    name = "ynab-mcp",
    srcs = [
        "client.go",
        "list.go",
        "mcp.go",
        "read.go",
        "write.go",
    ],
    importpath = "github.com/justinswe/ynab-mcp",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/ynab",
        "@com_github_justinswe_std//errors",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_uber_go_zap//:zap",
    ],
)

platform(
    name = "linux_amd64_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64_platform",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

LINUX_PLATFORMS = [
    ":linux_amd64_platform",
    ":linux_arm64_platform",
]

go_container_image(
    name = "image",
    additional_tags = {"latest": "latest"},
    base = "@distroless_base_debian13_nonroot",
    binary = "//cmd/ynab-mcp",
    platforms = LINUX_PLATFORMS,
    registry = "index.docker.io",
    repository = "justinswe/ynab-mcp",
    tag = MODULE_VERSION,
    visibility = ["//visibility:public"],
)

go_test(
    name = "ynab-mcp_test",
    size = "small",
    srcs = [
        "example_test.go",
        "ynabmcp_test.go",
    ],
    embed = [":ynab-mcp"],
    shard_count = 23,
    deps = [
        "//internal/ynab",
        "@com_github_justinswe_std//errors",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
